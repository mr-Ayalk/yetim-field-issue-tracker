{
  "name": "yetim-field-issue-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "An offline-first field issue tracker that works anywhere, even where there's no signal.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/prepare-database.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/require-env.mjs && prisma migrate deploy",
    "db:push": "node scripts/require-env.mjs && prisma db push",
    "db:seed": "node scripts/require-env.mjs && tsx prisma/seed.ts",
    "db:setup": "node scripts/require-env.mjs && prisma migrate deploy && tsx prisma/seed.ts",
    "format": "prettier --write .",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "dexie": "^4.2.0",
    "dexie-react-hooks": "^1.1.7",
    "lucide-react": "^0.544.0",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.63.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@hookform/resolvers": "^3.10.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "fake-indexeddb": "^6.2.2",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prisma": "^6.16.2",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
