# PostgreSQL connection. Never commit a real password.
DATABASE_URL=postgresql://yetim:yetim@localhost:5432/yetim

# Public origin used in documentation and absolute links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to false to disable demo fault injection and the demo reset endpoint.
YETIM_DEMO_MODE=true

# Optional: silent | info. Defaults to logging server failures only.
YETIM_LOG=info
